# =============================================================================
# JJ Motors — Compra Programada — Variáveis de ambiente
# -----------------------------------------------------------------------------
# Copie este arquivo para `.env` (que NUNCA é commitado) e preencha os valores.
# Em desenvolvimento local com `supabase start`, os valores de Supabase abaixo
# são impressos no terminal pelo comando e já vêm com defaults conhecidos.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — client-side (expostas ao browser, seguras por RLS)
# -----------------------------------------------------------------------------
# URL da API do Supabase.
#   Local (supabase start): http://127.0.0.1:54321
#   Produção: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave anônima / publishable. Segura para o browser — o acesso é limitado por RLS.
#   Local: o valor default abaixo é o mesmo em toda instalação do Supabase CLI.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# -----------------------------------------------------------------------------
# Supabase — server-side APENAS (NUNCA exponha no browser)
# -----------------------------------------------------------------------------
# service_role: ignora RLS. Usada só em route handlers (app/api/**), cron jobs e
# scripts (scripts/**). Se vazar, o banco inteiro fica exposto.
#   Local: valor default abaixo é o mesmo em toda instalação do Supabase CLI.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# String de conexão direta ao Postgres (usada por scripts de teste RLS via psql).
#   Local default:
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# -----------------------------------------------------------------------------
# Seed — credenciais dos usuários de exemplo criados por scripts/seed-auth.ts
# -----------------------------------------------------------------------------
# Senha única aplicada a TODOS os usuários do seed (admin + clientes).
# Só para desenvolvimento. Em produção os clientes definem a própria senha.
SEED_USER_PASSWORD=senha123

# -----------------------------------------------------------------------------
# WhatsApp — camada de provider (Fase 6)
# -----------------------------------------------------------------------------
# Qual implementação de WhatsAppProvider usar: "mock" | "meta"
#   mock  -> apenas loga no console e grava no banco (desenvolvimento)
#   meta  -> WhatsApp Cloud API oficial da Meta (produção)
WHATSAPP_PROVIDER=mock

# --- Meta Cloud API (obrigatório quando WHATSAPP_PROVIDER=meta) ---------------
# Token de acesso permanente do app da Meta (System User token recomendado).
WHATSAPP_TOKEN=
# ID do número de telefone cadastrado no WhatsApp Business (não é o telefone em si).
WHATSAPP_PHONE_NUMBER_ID=
# Versão da Graph API. Ex: v21.0
WHATSAPP_GRAPH_VERSION=v21.0
# Locale dos templates HSM aprovados. Ex: pt_BR
WHATSAPP_TEMPLATE_LOCALE=pt_BR

# -----------------------------------------------------------------------------
# Cron / Jobs — protege os endpoints acionados pela Vercel Cron
# -----------------------------------------------------------------------------
# Qualquer chamada a /api/cron/** precisa do header:  Authorization: Bearer <CRON_SECRET>
# Gere um valor aleatório forte: openssl rand -hex 32
CRON_SECRET=troque-por-um-valor-aleatorio-forte

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# URL pública da aplicação (usada em links de notificação, e-mails, etc).
NEXT_PUBLIC_APP_URL=http://localhost:3000
